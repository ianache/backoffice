# Copy to .env — never commit actual .env
# Used by docker-compose.yml. All app services (backend, bff, portal) point to the
# remote QA Keycloak by default — no need to start the local `keycloak`/`postgres`
# services unless you explicitly run `docker compose --profile local-keycloak up`.

# --- Keycloak (shared) ---
KEYCLOAK_URL=https://oauth2.qa.comsatel.com.pe
KEYCLOAK_REALM=Apps

# bff confidential client (get secret from Keycloak QA admin console)
KEYCLOAK_CLIENT_ID=backoffice-bff
KEYCLOAK_CLIENT_SECRET=<get-from-keycloak-admin>

# portal public client (PKCE, no secret)
VITE_KEYCLOAK_CLIENT_ID=backoffice-portal

# Admin API client shared by backend + bff (manage-users)
KEYCLOAK_ADMIN_CLIENT_ID=backoffice-admin-svc
KEYCLOAK_ADMIN_CLIENT_SECRET=<generate-in-keycloak-dashboard>

# --- Local Keycloak container (only used with --profile local-keycloak) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Shared secrets ---
INTERNAL_SECRET=dev-internal-secret-change-in-prod
SDK_SECRET_KEY=dev-sdk-secret-change-in-prod

# --- Backend (Python FastAPI) ---
# Local (non-docker) run: MYSQL_URL=mysql+asyncmy://backoffice:backoffice@localhost:3306/backoffice
BACKEND_URL=http://localhost:8000
MYSQL_URL=mysql+asyncmy://backoffice:backoffice@localhost:3306/backoffice

# --- Portal ---
FRONTEND_URL=http://localhost:5173
VITE_BO_TENANT_ID=2
