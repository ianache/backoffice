{
  "realm": "backoffice",
  "enabled": true,
  "displayName": "BackOffice Platform",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionMaxLifespan": 36000,
  "refreshTokenMaxReuse": 0,
  "revokeRefreshToken": false,
  "attributes": {
    "frontendUrl": "",
    "acr.loa.map": "{}",
    "cibaBackchannelTokenDeliveryMode": "poll",
    "cibaExpiresIn": "120",
    "cibaInterval": "5",
    "cibaAuthRequestedUserHint": "login_hint",
    "oauth2DeviceCodeLifespan": "600",
    "oauth2DevicePollingInterval": "5",
    "parRequestUriLifespan": "60",
    "shortVerificationUri": ""
  },
  "roles": {
    "realm": [
      {
        "id": "role-platform-admin",
        "name": "PlatformAdmin",
        "description": "Full platform administration access",
        "composite": false,
        "clientRole": false,
        "containerId": "backoffice"
      },
      {
        "id": "role-tenant-owner",
        "name": "TenantOwner",
        "description": "Owns a tenant; can manage tenant settings and admins",
        "composite": false,
        "clientRole": false,
        "containerId": "backoffice"
      },
      {
        "id": "role-tenant-admin",
        "name": "TenantAdmin",
        "description": "Administers a tenant",
        "composite": false,
        "clientRole": false,
        "containerId": "backoffice"
      },
      {
        "id": "role-tenant-viewer",
        "name": "TenantViewer",
        "description": "Read-only access within a tenant",
        "composite": false,
        "clientRole": false,
        "containerId": "backoffice"
      },
      {
        "id": "role-product-manager",
        "name": "ProductManager",
        "description": "Manages product definitions and configurations",
        "composite": false,
        "clientRole": false,
        "containerId": "backoffice"
      },
      {
        "id": "role-product-developer",
        "name": "ProductDeveloper",
        "description": "Develops and configures product features",
        "composite": false,
        "clientRole": false,
        "containerId": "backoffice"
      },
      {
        "id": "role-product-qa",
        "name": "ProductQA",
        "description": "QA access to test product features",
        "composite": false,
        "clientRole": false,
        "containerId": "backoffice"
      },
      {
        "id": "role-company-admin",
        "name": "CompanyAdmin",
        "description": "Administers a company within a tenant",
        "composite": false,
        "clientRole": false,
        "containerId": "backoffice"
      },
      {
        "id": "role-company-user",
        "name": "CompanyUser",
        "description": "Standard company user",
        "composite": false,
        "clientRole": false,
        "containerId": "backoffice"
      },
      {
        "id": "role-ux-writer",
        "name": "UXWriter",
        "description": "Can edit localized label translation values in active locales; read-only on namespace/key structure",
        "composite": false,
        "clientRole": false,
        "containerId": "backoffice"
      }
    ]
  },
  "clients": [
    {
      "id": "backoffice-frontend-id",
      "clientId": "backoffice-frontend",
      "name": "BackOffice Frontend",
      "description": "Vue 3 shell portal (public PKCE client)",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "login_theme": "",
        "access.token.lifespan": "300",
        "token.endpoint.auth.signing.alg": "RS256",
        "use.lightweight.access.token.enabled": "false",
        "token.response.type.bearer.lower-case": "false"
      },
      "fullScopeAllowed": true,
      "nodeReRegistrationTimeout": -1,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "id": "backoffice-bff-id",
      "clientId": "backoffice-bff",
      "name": "BackOffice BFF",
      "description": "Node.js backend-for-frontend (confidential client)",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "backoffice-bff-secret",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "use.lightweight.access.token.enabled": "false",
        "token.endpoint.auth.signing.alg": "RS256"
      },
      "fullScopeAllowed": true,
      "nodeReRegistrationTimeout": -1,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "users": [
    {
      "id": "seed-platform-admin-id",
      "username": "admin@backoffice.dev",
      "email": "admin@backoffice.dev",
      "firstName": "Platform",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Admin1234!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "PlatformAdmin"
      ],
      "clientRoles": {}
    }
  ],
  "scopeMappings": [],
  "clientScopeMappings": {},
  "components": {},
  "internationalizationEnabled": false,
  "supportedLocales": [],
  "defaultLocale": ""
}
